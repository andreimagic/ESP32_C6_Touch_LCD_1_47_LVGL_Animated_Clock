{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: ESP32-C6 Touch LCD 1.47",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "esp32:esp32:esp32c6:JTAGAdapter=default,CDCOnBoot=cdc,PartitionScheme=default_8MB,CPUFreq=160,FlashMode=qio,FlashFreq=80,FlashSize=8M,ZigbeeMode=default,DebugLevel=none",
        "--warnings",
        "default",
        "--output-dir",
        "build-out/esp32c6-lcd147",
        "."
      ],
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Build: ESP32-S3 Touch LCD 1.47",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "esp32:esp32:esp32s3:JTAGAdapter=default,PSRAM=opi,CDCOnBoot=default,USBMode=default,PartitionScheme=app3M_fat9M_16MB,CPUFreq=240,FlashMode=qio,FlashSize=16M,ZigbeeMode=default,DebugLevel=none",
        "--warnings",
        "default",
        "--output-dir",
        "build-out/esp32s3-lcd147",
        "."
      ],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Build: both boards",
      "dependsOn": [
        "Build: ESP32-C6 Touch LCD 1.47",
        "Build: ESP32-S3 Touch LCD 1.47"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },

    {
      "label": "Full image: ESP32-C6 (flashable *-full.bin)",
      "type": "shell",
      "command": "bash",
      "args": [
        ".devcontainer/scripts/build-full-bin.sh",
        "esp32c6",
        "build-out/esp32c6-lcd147"
      ],
      "dependsOn": ["Build: ESP32-C6 Touch LCD 1.47"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "Same trim release.yml does: cuts the whole-chip merged.bin down to bootloader+partitions+app. Output lands in dist/."
    },
    {
      "label": "Full image: ESP32-S3 (flashable *-full.bin)",
      "type": "shell",
      "command": "bash",
      "args": [
        ".devcontainer/scripts/build-full-bin.sh",
        "esp32s3",
        "build-out/esp32s3-lcd147"
      ],
      "dependsOn": ["Build: ESP32-S3 Touch LCD 1.47"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "detail": "Same trim release.yml does: cuts the whole-chip merged.bin down to bootloader+partitions+app. Output lands in dist/."
    },
    {
      "label": "Full image: both boards",
      "dependsOn": [
        "Full image: ESP32-C6 (flashable *-full.bin)",
        "Full image: ESP32-S3 (flashable *-full.bin)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}